{
	servers {
		# One TCP connection per request, like the app's parallel downloads,
		# so the speed test's multi-connection numbers are real.
		protocols h1
	}
}

# Download relay for the Kazumi library on Hetzner (kazumi.kaic5504.com).
# Only episode files pass through; Hetzner still checks the token on each request.
hk.kaic5504.com {
	handle /episodes/* {
		reverse_proxy https://kazumi.kaic5504.com {
			header_up Host kazumi.kaic5504.com
			flush_interval -1
		}
	}
	handle /healthz {
		respond "ok" 200
	}
	@netprobe path /speed /speed/*
	handle @netprobe {
		reverse_proxy 127.0.0.1:8780 {
			flush_interval -1
		}
	}
	handle /speedtest/* {
		root * /srv
		file_server
	}
	handle {
		respond 404
	}
}

# Plain-HTTP speed test by IP, for quick checks from China.
:80 {
	root * /srv/speedtest
	file_server
}
