{
	servers {
		# One TCP connection per request, like the app's parallel downloads,
		# so the speed test's multi-connection numbers are real.
		protocols h1
	}
}

# Download relay for the Kazumi library on Hetzner (kazumi.kaic5504.com).
# Only episode files pass through; Hetzner still checks the token on each request.
hk.kaic5504.com {
	handle /episodes/* {
		reverse_proxy https://kazumi.kaic5504.com {
			header_up Host kazumi.kaic5504.com
			flush_interval -1
		}
	}
	handle /healthz {
		respond "ok" 200
	}
	@netprobe path /speed /speed/*
	handle @netprobe {
		reverse_proxy 127.0.0.1:8780 {
			flush_interval -1
		}
	}
	# latest.json for the app's update prompt; written by
	# `scripts/codemagic.py publish-latest`.
	handle /app/* {
		header Cache-Control no-store
		root * /srv
		file_server
	}
	# Official rule catalog for mainland China, where GitHub raw is blocked and
	# GitCode's WAF rejects the app. Refreshed weekly by kazumi-rules-sync.timer.
	handle_path /rules/* {
		header Cache-Control "public, max-age=300"
		root * /srv/rules
		file_server {
			hide .git
		}
	}
	handle /speedtest/* {
		root * /srv
		file_server
	}
	handle {
		respond 404
	}
}

# Plain-HTTP speed test by IP, for quick checks from China.
:80 {
	root * /srv/speedtest
	file_server
}
