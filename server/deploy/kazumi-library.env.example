# Copy to /etc/kazumi-library.env (root:kazumi-library, mode 0640) and fill in the keys.
# Generate each key with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KAZUMI_LIBRARY_DATA=/srv/kazumi-library
KAZUMI_VIEW_KEY=
KAZUMI_ADMIN_KEY=
KAZUMI_SYNCPLAY_ENDPOINT=kazumi.kaic5504.com:8999
KAZUMI_SYNCPLAY_ROOM=
KAZUMI_SYNCPLAY_TLS=0
# Optional relays for /episodes/*, comma separated, e.g. https://hk.kaic5504.com
KAZUMI_DOWNLOAD_MIRRORS=
